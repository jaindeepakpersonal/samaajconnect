{
  "name": "samaajconnect",
  "private": true,
  "description": "Multi-tenant platform for Jain Samaaj organizations - Angular apps and shared libraries.",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve member-portal",
    "start:admin": "ng serve admin-portal",
    "build": "ng build member-portal",
    "build:admin": "ng build admin-portal",
    "test:app": "ng test member-portal --watch=false",
    "test:admin": "ng test admin-portal --watch=false",
    "test:libs": "vitest run",
    "test": "npm run test:libs && npm run test:app && npm run test:admin"
  },
  "devDependencies": {
    "@angular/cli": "^20.3.35",
    "vitest": "^3.2.4",
    "jsdom": "^26.0.0"
  }
}
