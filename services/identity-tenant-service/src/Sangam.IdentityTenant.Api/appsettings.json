{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=samaajconnect_identity;Username=samaajconnect;Password=samaajconnect"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "identity-tenant-service"
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Jwt": {
    "Issuer": "samaajconnect",
    "Audience": "samaajconnect",
    "AccessTokenMinutes": 60
  }
}
