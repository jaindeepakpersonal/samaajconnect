{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=samaajconnect_audit_notification;Username=samaajconnect;Password=samaajconnect"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "audit-notification-service"
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 50,
    "MaxAttempts": 10
  },
  "Consumer": {
    "MaxAttempts": 5,
    "RetryDelayMilliseconds": 500
  },
  "NotificationDelivery": {
    "Enabled": true,
    "PollIntervalSeconds": 10,
    "BatchSize": 25,
    "StalledAfterMinutes": 5,
    "Logging": {
      "//": "Writes full addresses and message bodies to the log. Local development only - see LoggingChannelOptions.",
      "RevealContent": false
    }
  },
  "Jwt": {
    "Issuer": "samaajconnect",
    "Audience": "samaajconnect",
    "//": "Validation only. This service never issues a token, so the lifetime is not its decision - see identity-tenant-service."
  }
}
