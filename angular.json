{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "apps",
  "projects": {
    "member-portal": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/member-portal",
      "sourceRoot": "apps/member-portal/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/member-portal/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/member-portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/member-portal/public"
              }
            ],
            "styles": [
              "apps/member-portal/src/styles.css"
            ],
            "server": "apps/member-portal/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "apps/member-portal/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/member-portal/src/environments/environment.ts",
                  "with": "apps/member-portal/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "member-portal:build:production"
            },
            "development": {
              "buildTarget": "member-portal:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "apps/member-portal/proxy.conf.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/member-portal/tsconfig.spec.json",
            "buildTarget": "::development",
            "runner": "vitest",
            "include": [
              "apps/member-portal/src/**/*.spec.ts"
            ]
          }
        }
      }
    },
    "admin-portal": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/admin-portal",
      "sourceRoot": "apps/admin-portal/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/admin-portal/src/main.ts",
            "index": "apps/admin-portal/src/index.html",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/admin-portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/admin-portal/public"
              }
            ],
            "styles": [
              "apps/admin-portal/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "apps/admin-portal/src/environments/environment.ts",
                  "with": "apps/admin-portal/src/environments/environment.production.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "admin-portal:build:production"
            },
            "development": {
              "buildTarget": "admin-portal:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "apps/admin-portal/proxy.conf.json",
            "port": 4300
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "apps/admin-portal/tsconfig.spec.json",
            "buildTarget": "::development",
            "runner": "vitest",
            "include": [
              "apps/admin-portal/src/**/*.spec.ts"
            ]
          }
        }
      }
    }
  }
}
